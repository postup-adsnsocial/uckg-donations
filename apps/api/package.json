    "@uckg/contracts": "workspace:*",
    "@uckg/database": "workspace:*",
    "drizzle-orm": "0.44.4",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/pg": "8.15.5",
    "tsx": "4.20.3"
