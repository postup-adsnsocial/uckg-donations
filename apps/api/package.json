{
  "name": "@uckg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @uckg/authorization --filter @uckg/contracts --filter @uckg/database build && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "seed": "tsx src/seed.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@uckg/authorization": "workspace:*",
    "@uckg/contracts": "workspace:*",
    "@uckg/database": "workspace:*",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.0.14"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/pg": "8.15.5",
    "tsx": "4.20.3"
  }
}
