{
  "name": "uckg-donations",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma multi-tenant de gestão de doações da UCKG",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "concurrently -k -n api,web,worker -c blue,green,magenta \"pnpm --filter @uckg/api dev\" \"pnpm --filter @uckg/web dev\" \"pnpm --filter @uckg/worker dev\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @uckg/database db:generate"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "1.54.1",
    "@types/node": "24.1.0",
    "concurrently": "9.2.0",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.4"
  }
}
