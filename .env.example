NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
# Runtime API credentials only. Never use the migration/owner login here.
DATABASE_URL=postgresql://uckg:uckg@localhost:5432/uckg_donations
# Privileged schema credential used only by pnpm db:migrate.
MIGRATION_DATABASE_URL=postgresql://uckg:uckg@localhost:5432/uckg_donations
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY=false
# Required in production; generate and inject a secret rather than committing one.
METRICS_TOKEN=
BODY_LIMIT=256kb
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_READY_TIMEOUT_MS=1000
LOGIN_SOURCE_LIMIT=10
LOGIN_SOURCE_WINDOW_MS=60000
LOGIN_ACCOUNT_LIMIT=5
LOGIN_ACCOUNT_WINDOW_MS=900000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Deployment note: provision the API and managed PostgreSQL together, provisionally in
# us-east-1 (Northern Virginia). This is a deployment choice, not an application default.

# Bootstrap administrativo local; preencha somente antes de executar pnpm db:seed.
SEED_CHURCH_NAME=
SEED_CHURCH_SLUG=
SEED_ADMIN_EMAIL=
SEED_ADMIN_DISPLAY_NAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=church_admin
